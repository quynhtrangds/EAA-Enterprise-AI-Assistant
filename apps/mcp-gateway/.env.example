NODE_ENV=development
PORT=8081

POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=enterprise_ai_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root

JWT_SECRET=your-secret-key-at-least-32-chars-long
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Health-check tự động: chu kỳ quét (phút), 0 = tắt hẳn
HEALTH_CHECK_INTERVAL_MINUTES=10

# Email cảnh báo sự cố (giai đoạn C) — chỉ kích hoạt khi có cả SMTP_HOST + HEALTH_ALERT_EMAIL
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=email, SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EAA Health-check <no-reply@company.com>
HEALTH_ALERT_EMAIL=

