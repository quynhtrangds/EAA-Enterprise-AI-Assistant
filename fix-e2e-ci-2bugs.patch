diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index ca784e6..80905aa 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -210,6 +210,18 @@ jobs:
           cp apps/ai-orchestrator/.env.example apps/ai-orchestrator/.env 2>/dev/null || touch apps/ai-orchestrator/.env
           cp apps/mcp-gateway/.env.example apps/mcp-gateway/.env 2>/dev/null || touch apps/mcp-gateway/.env

+      - name: Build connector packages
+        # mcp-gateway container chỉ tự build chính nó (npm run build trong
+        # command của service mcp-gateway) — KHÔNG build các package trong
+        # /packages (mount qua volume ./packages:/packages). Vì dist/ của
+        # các package này bị .gitignore nên trên checkout sạch của CI chưa
+        # từng tồn tại. Thiếu bước này, mcp-gateway sẽ báo lỗi "Cannot find
+        # module .../dist/index.js" ngay khi Playwright gọi bất kỳ tool nào.
+        run: |
+          for d in packages/mcp-server-*; do
+            (cd "$d" && npm ci && npm run build)
+          done
+
       - name: Start Full Stack with Docker Compose
         run: |
           docker compose up -d
diff --git a/apps/chat-ui/playwright.config.ts b/apps/chat-ui/playwright.config.ts
index cc7d535..cc04222 100644
--- a/apps/chat-ui/playwright.config.ts
+++ b/apps/chat-ui/playwright.config.ts
@@ -20,7 +20,16 @@ export default defineConfig({
   webServer: {
     command: 'npm run dev',
     url: 'http://localhost:3000',
-    reuseExistingServer: !process.env.CI,
+    // Luôn true: khi chạy trong CI, docker-compose đã khởi động chat-ui
+    // (cùng mcp-gateway/ai-orchestrator/postgres thật) trên port 3000 TRƯỚC
+    // khi Playwright chạy — nếu để `!process.env.CI` (= false trong CI vì
+    // GitHub Actions luôn set CI=true), Playwright sẽ cố tự spawn thêm 1
+    // dev server nữa, và do vite.config.ts có strictPort:true, lệnh `npm
+    // run dev` sẽ crash ngay vì port 3000 đã bị docker-compose chiếm.
+    // reuseExistingServer:true giúp Playwright nhận diện server đang chạy
+    // và dùng lại — vẫn tự khởi động bình thường khi chạy dev cục bộ nếu
+    // chưa có server nào ở port 3000.
+    reuseExistingServer: true,
     timeout: 120 * 1000,
   },
 });
