-  onToggleSidebar?: () =&gt; void;
-  onLogout?: () =&gt; void;
-  onRenameSession?: (id: string, newTitle: string) =&gt; void;
-  onToggleStarSession?: (id: string, isStarred: boolean) =&gt; void;
-  onOpenSearch?: () =&gt; void;
-}
-&nbsp;
-const Sidebar: React.FC&lt;SidebarProps&gt; = ({
